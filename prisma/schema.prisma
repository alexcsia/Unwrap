generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ListeningHistory {
  id              String   @id @default(uuid())
  userId          String
  platformName    String
  platformTrackId String
  playedAt        DateTime
  trackName       String
  albumName       String
  durationMs      Int
  source          String
  metadata        Json
  uploadedAt      DateTime @default(now())

  
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artists         Artist[] @relation("TrackArtists") 

  @@index([userId, playedAt])
  @@unique([userId, platformTrackId, playedAt])
}

model Artist {
  id           String             @id @default(uuid())
  name         String             @unique
  platformId    String?            @unique 
  imageUrl     String?
  genres       String[]           @default([])
  
  history      ListeningHistory[] @relation("TrackArtists")

  @@index([name])
}

model User {
  id           String   @id @default(uuid())
  // spotifyId    String   @unique
  displayName  String
  email        String     @unique
  passwordHash String
  createdAt   DateTime @default(now())

  listeningHistory   ListeningHistory[]
  internalSessions   InternalAuthSessions[]
  connectedPlatforms ConnectedPlatforms[]
}

model InternalAuthSessions {
  id           String   @id @default(uuid())
  userId       String @unique
  RefreshToken String @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model ConnectedPlatforms {
  id             String   @id @default(uuid())
  userId         String
  platformName   String
  platformUserId String
  AccessToken    String
  RefreshToken   String
  expiresAt     DateTime
  connectedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platformName])
}