{
  "name": "unwrapofficial",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "bun-types": "^1.3.12",
    "cross-env": "^10.1.0",
    "prisma-markdown": "^4.0.0"
  },
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/app.ts",
    "dev:worker": "bun run --watch src/workers/index.ts",
    "build": "cross-env NODE_ENV=production bun build src/app.ts --outdir dist --target node && cross-env NODE_ENV=production bun build src/workers/index.ts --outdir dist/workers --target node",
    "start": "bunx pm2 start ecosystem.config.cjs --no-daemon",
    "start:worker": "bun dist/workers/index.js",
    "test": "bun test"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@prisma/client": "^6.5.0",
    "@spotify/web-api-ts-sdk": "^1.2.0",
    "@types/adm-zip": "^0.5.7",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.14",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.73.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "msw": "^2.12.10",
    "multer": "^1.4.5-lts.2",
    "package.json": "^2.0.1",
    "pm2": "^6.0.14",
    "prisma": "^6.5.0",
    "supertest": "^7.2.2",
    "zod": "^4.3.6"
  }
}
