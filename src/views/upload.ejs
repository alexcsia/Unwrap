<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Upload Listening History</title>
  <link rel="stylesheet" href="/styles.css"> <!-- Optional: Link to a CSS file -->
</head>
<body>
  <header>
    <h1>Upload Your Listening History</h1>
  </header>

  <main>
    <form action="/upload" method="POST" enctype="multipart/form-data">
      <label for="historyFile">Select a zip file containing your listening history:</label>
      <input type="file" id="historyFile" name="history" accept=".zip" required>
      <button type="submit">Upload</button>
    </form>
  </main>
</body>
</html>